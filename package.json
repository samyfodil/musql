{
  "name": "@samyfodil/musql-console",
  "version": "0.0.0",
  "private": true,
  "description": "The musql console as a library, installable from git. The console itself is cloud/console.",
  "type": "module",
  "exports": {
    ".": "./cloud/console/src/index.js",
    "./vite": "./cloud/console/vite-plugin.js"
  },
  "files": [
    "cloud/console/src",
    "cloud/console/vite-plugin.js",
    "npm/package.json",
    "npm/index.js",
    "npm/musql.wasm",
    "npm/wasm_exec.js",
    "npm/memfs.js",
    "npm/glue.js"
  ],
  "scripts": {
    "prepare": "sh npm/build.sh"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@connectrpc/connect": "2.1.1",
    "@connectrpc/connect-web": "2.1.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@huggingface/transformers": "^3.8.1",
    "@libsql/client": "0.18.0",
    "@noble/hashes": "2.4.0",
    "@samyfodil/musql": "file:npm",
    "@uiw/react-codemirror": "^4.23.0",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^0.468.0",
    "recharts": "^3.10.1",
    "sql-formatter": "^15.9.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/samyfodil/musql.git"
  }
}
