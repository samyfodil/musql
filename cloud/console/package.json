{
  "name": "@samyfodil/musql-console",
  "private": true,
  "version": "0.0.0",
  "description": "The musql console as a React library: a browser database editor over @samyfodil/musql, with slots for an app's own pages, tabs, banners, name and theme.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samyfodil/musql.git",
    "directory": "cloud/console"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./vite": "./vite-plugin.js",
    "./style.css": "./src/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test",
    "preview": "vite preview",
    "example": "vite -c example/vite.config.js",
    "build:example": "vite build -c example/vite.config.js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@connectrpc/connect": "2.1.1",
    "@connectrpc/connect-web": "2.1.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@huggingface/transformers": "^3.8.1",
    "@libsql/client": "0.18.0",
    "@noble/hashes": "2.4.0",
    "@samyfodil/musql": "file:../../npm",
    "@uiw/react-codemirror": "^4.23.0",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^0.468.0",
    "recharts": "^3.10.1",
    "sql-formatter": "^15.9.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
