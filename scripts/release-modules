#!/usr/bin/env bash
# Points every module in the repository at the published ones at a release
# version, so that a consumer gets them from one release with no replace.
# usage: scripts/release-modules vX.Y.Z
#
# The published modules are the root, cloud, hrana and examples/libp2p; each
# go.mod that requires one of them now requires it at vX.Y.Z. The replace
# directives stay, for development; a consumer ignores them. The release
# workflow runs this for the tag it builds and fails when it changes anything.
set -euo pipefail
v=${1:?usage: release-modules vX.Y.Z}
[[ $v =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] || { echo "not a release version: $v" >&2; exit 2; }
root=$(cd "$(dirname "$0")/.." && pwd)
m=github.com/samyfodil/musql
published=("$m" "$m/cloud" "$m/hrana" "$m/examples/libp2p")

cd "$root"
git ls-files '*go.mod' | while read -r f; do
  required=$(go mod edit -json "$f" | jq -r '.Require[]?.Path')
  args=()
  for p in "${published[@]}"; do
    if grep -qxF "$p" <<<"$required"; then
      args+=("-require=$p@$v")
    fi
  done
  if [ ${#args[@]} -gt 0 ]; then
    go mod edit "${args[@]}" "$f"
  fi
done
